DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# To switch from SQLite to PostgreSQL, uncomment and set a database URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/contacts_crm

# UniSender API settings. Leave blank to keep the integration disabled.
UNISENDER_API_KEY=
UNISENDER_LIST_ID=
# Use a long random token in the callback URL /hooks/unisender/<token>/
UNISENDER_WEBHOOK_TOKEN=
# These UniSender field names must match fields configured in your account.
UNISENDER_FIELD_FIRST_NAME=Name
UNISENDER_FIELD_LAST_NAME=LastName
UNISENDER_FIELD_COMPANY=Company
UNISENDER_FIELD_POSITION=Position
